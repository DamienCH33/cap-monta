###> symfony/framework-bundle ###
APP_ENV=dev
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/capmonta?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# timeout et read_timeout : abandon en 1 s si Redis ne répond pas (ADR 021).
LOCK_DSN=redis://127.0.0.1:6379?timeout=1&read_timeout=1
###< symfony/lock ###

REDIS_URL=redis://127.0.0.1:6379

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

# Vide en local : l'API est appelée en direct, aucune en-tête X-Forwarded-For n'est crue
# (sinon chacun choisit son IP et contourne les limites). En production : le réseau privé de
# Railway uniquement, par exemple TRUSTED_PROXIES=PRIVATE_SUBNETS (ADR 022).
TRUSTED_PROXIES=
###> app ###
MAILER_DSN=smtp://localhost:1025
MAILER_FROM=cap-monta@example.com
APP_FRONT_URL=http://localhost:4201
# Reçoit les signalements d’annonces. En production : une adresse lue chaque jour.
APP_MODERATION_EMAIL=moderation@example.com
# Détail de /api/health (base, cache, worker) pour qui envoie X-Health-Token. Vide : jamais.
HEALTH_TOKEN=
###< app ###

###> photos ###
# Dossier des photos, relatif au projet, et adresse publique correspondante.
# En production : stockage objet (R2/S3), jamais le disque du conteneur.
PHOTOS_DIR=public/media/photos
PHOTOS_BASE_URL=http://127.0.0.1:8001/media/photos
# Dossier de vraies photos pour les fixtures (hors dépôt). Vide : logements sans photo.
# À définir dans .env.local, par exemple FIXTURE_PHOTOS_DIR=~/Images/cap-monta-test
FIXTURE_PHOTOS_DIR=
###< photos ###
