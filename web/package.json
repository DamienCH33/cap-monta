{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "icons": "node scripts/build-icons.cjs",
    "photos": "node scripts/build-site-photos.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n:extract": "ng extract-i18n --format=json --output-path src/locale",
    "start:en": "ng serve --configuration=en",
